# === Required Configuration ===

# Groq API Key — Get yours from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogiq

# === Server ===

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Comma-separated CORS origins (no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Groq / LLM ===

# Groq retired llama-3.3-70b-versatile in Aug 2026 — use gpt-oss-120b instead
# Reasoning models require GROQ_MAX_COMPLETION_TOKENS (not max_tokens alone)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
GROQ_SEO_TEMPERATURE=0.3
GROQ_MAX_TOKENS=500
GROQ_SEO_MAX_TOKENS=200
GROQ_MAX_RETRIES=3
GROQ_RETRY_DELAY_SECONDS=1
GROQ_BATCH_DELAY_MS=250
GROQ_MIN_DESCRIPTION_WORDS=20
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_REASONING_EFFORT=low
GROQ_REASONING_FORMAT=hidden
SEO_TITLE_MAX_LENGTH=60

# === Database Pool ===

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# === Scraping ===

SCRAPE_INTERVAL_HOURS=6
SCRAPE_REQUEST_TIMEOUT=15
SCRAPE_DELAY_MS=1500
SCRAPE_MAX_RETRIES=2
SCRAPE_RETRY_BACKOFF_SEC=2

# Competitor monitoring — one setting applies app-wide (scrape, alerts, prices, UI):
# - us: Amazon US + Walmart US (default; eBay/Target hidden until API/browser support)
# - in: Amazon India + Flipkart
SCRAPE_REGION=us

# Optional per-marketplace URL overrides (advanced — rarely needed)
# MARKETPLACE_AMAZON_SEARCH_URL=https://www.amazon.com/s?k={query}
# MARKETPLACE_AMAZON_BASE_URL=https://www.amazon.com
# MARKETPLACE_AMAZON_CURRENCY=USD
# MARKETPLACE_AMAZON_LABEL=Amazon US
#
# MARKETPLACE_WALMART_SEARCH_URL=https://www.walmart.com/search?q={query}
# MARKETPLACE_WALMART_BASE_URL=https://www.walmart.com
# MARKETPLACE_WALMART_CURRENCY=USD
#
# MARKETPLACE_FLIPKART_SEARCH_URL=https://www.flipkart.com/search?q={query}
# MARKETPLACE_FLIPKART_BASE_URL=https://www.flipkart.com
# MARKETPLACE_FLIPKART_CURRENCY=INR

# === Competitor Alerts ===

USD_INR_EXCHANGE_RATE=83.0
ALERT_UNDERCUT_THRESHOLD_PCT=5
ALERT_PRICE_CHANGE_THRESHOLD_PCT=10

# === Authentication ===

# Change in production — used to sign JWT access tokens
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Default admin user seeded on startup (created only if missing)
DEFAULT_ADMIN_EMAIL=admin@catalogiq.local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Admin

# === Logging ===

LOG_LEVEL=INFO
